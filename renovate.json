
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": true,
  "automerge": false,
  "kubernetes": {
    "managerFilePatterns": [
      "/\\.ya?ml$/"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      "/(^|/)values\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Inline image references in Helm values",
      "managerFilePatterns": [
        "/(^|/)values\\.ya?ml$/"
      ],
      "matchStrings": [
        "image:[ \\t]*[\"']?(?<depName>[\\w./-]+):(?<currentValue>[\\w.-]+)(?:@(?<currentDigest>sha256:[a-fA-F0-9]{64}))?"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "autoReplaceStringTemplate": "image: {{{depName}}}:{{{newValue}}}{{#if newDigest}}@{{{newDigest}}}{{/if}}"
    }
  ],
  "packageRules": [
    {
      "description": "Pin container images to immutable digests",
      "matchDatasources": ["docker"],
      "pinDigests": true
    },
    {
      "description": "External images: PR only, no automerge",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "!/^registry\\.services\\.atlantishq\\.de\\/atlantishq\\//"
      ],
      "groupName": "external container images",
      "automerge": false
    },
    {
      "description": "Internal Harbor images: automerge",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "/^registry\\.services\\.atlantishq\\.de\\/atlantishq\\//"
      ],
      "groupName": "internal container images",
      "minimumReleaseAge": null,
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false,
      "ignoreTests": true
    }
  ]
}

